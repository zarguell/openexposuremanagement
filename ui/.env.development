# Development environment configuration
# This file is used when running `npm run dev` locally

# For local development with backend running in docker:
# Uncomment the line below:
# API_BASE_URL=http://localhost:8080

# For local development with backend running locally:
# Uncomment the line below:
# API_BASE_URL=http://localhost:8080

# For development inside docker-compose:
# The docker-compose.yml sets API_BASE_URL=http://api:8080 automatically
