# API Base URL for proxying API requests during development
# This should point to your backend API server
# Examples:
#   - API_BASE_URL=http://localhost:8080 (default, local development)
#   - API_BASE_URL=http://api:8080 (when using docker-compose service names)
#   - API_BASE_URL=https://api.example.com (production backend)
API_BASE_URL=http://localhost:8080

# OIDC Configuration
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=

# Environment (development | production)
VITE_ENV=development
